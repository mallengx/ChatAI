<Window x:Class="ChatAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:ChatAI.Converters"
        mc:Ignorable="d"
        Title="ChatAI" 
        Height="800" 
        Width="770"
        MinWidth="500"  
        MinHeight="400">
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Resource/Images/fondos14.jpg" 
                    Stretch="UniformToFill"/>
    </Window.Background>
    <Window.Resources>
        <local:BoolToMicIconConverter x:Key="BoolToMicIconConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>

        <!-- Estilo para los bocadillos de diálogo -->
        <Style x:Key="BocadilloUsuario" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="TextBlock.FontSize" Value="16"/>
        </Style>

        <Style x:Key="BocadilloIA" TargetType="Border">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10,5,0,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="10" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="TextBlock.FontSize" Value="16"/>
        </Style>

        <!-- Estilo para el botón que muestra la franja azul al 20% de opacidad -->
        <Style x:Key="MensajeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Cambiar el fondo cuando el cursor está sobre el botón -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#330000FF"/>
                                <!-- Azul con 20% de opacidad -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="White" 
                BorderBrush="Black" 
                BorderThickness="3" 
                CornerRadius="0"
                Padding="15"
                Margin="0,0,0,15"
                HorizontalAlignment="Stretch">
            <Image Source="pack://application:,,,/Resource/Images/mia.png"
                   Height="60" 
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>
        </Border>

        <!-- Panel Lateral Izquierdo -->
        <Border Grid.Column="0" Grid.Row="1" Margin="0,0,10,0" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="0">
            <StackPanel>
                <!-- Botón con imagen de katana y texto superpuesto -->
                <Button Command="{Binding NuevaConversacionCommand}" 
                        Margin="0" 
                        Height="100" 
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Imagen de la katana -->
                        <Image Source="pack://application:,,,/Resource/Images/katanavacia2.png" Stretch="Fill" Opacity="0.5"/>
                        <!-- Texto superpuesto -->
                        <TextBlock Text="+ Nueva Conversación" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.8" BlurRadius="5" ShadowDepth="2"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- Nueva imagen (grillo2.png) -->
                <Image Source="pack://application:,,,/Resource/Images/grillo3.jpg" 
                       Margin="0,100,10,10" 
                       Height="420" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- GIF dinámico (katana.gif o katana2.gif) -->
        <Border Grid.Column="0" Grid.Row="2" Margin="0,10,10,10" Background="Transparent">
            <Image gif:ImageBehavior.AnimatedSource="{Binding GifSource}" 
                   Height="100" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Left"/>
        </Border>

        <!-- Lista de Mensajes con imagen de fondo -->
        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="0">
            <Grid>
                <!-- Imagen de fondo (katana3.png) con opacidad reducida -->
                <Image Source="pack://application:,,,/Resource/Images/katana3.jpg" 
                       Stretch="UniformToFill" 
                       VerticalAlignment="Bottom" 
                       HorizontalAlignment="Stretch"
                       Opacity="0.3"/>

                <!-- ScrollViewer y bocadillos de diálogo -->
                <ScrollViewer x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mensajes}" Background="Transparent" BorderThickness="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,5">
                                    <!-- Bocadillo del Usuario -->
                                    <Border Style="{StaticResource BocadilloUsuario}"
                                            Visibility="{Binding EsUsuario, Converter={StaticResource BoolToVisibilityConverter}}"
                                            MaxWidth="650">
                                        <TextBlock Text="{Binding Contenido}" 
                                                   TextWrapping="Wrap"
                                                   Foreground="Black"/>
                                    </Border>
                                    <!-- Bocadillo de la IA -->
                                    <Border Style="{StaticResource BocadilloIA}"
                                            Visibility="{Binding EsUsuario, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                            MaxWidth="650">
                                        <TextBlock Text="{Binding Contenido}" 
                                                   TextWrapping="Wrap"
                                                   Foreground="Black"/>
                                    </Border>
                                    <!-- Botón invisible para manejar el clic -->
                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Command="{Binding DataContext.LeerMensajeCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MensajeButtonStyle}"/>
                                    <!-- Aplicar el estilo aquí -->
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Controles de Entrada -->
        <Border Grid.Row="2" Grid.Column="1" 
                Background="White" 
                BorderBrush="Black" 
                BorderThickness="3" 
                CornerRadius="0" 
                Margin="0,10,0,0"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" 
                         Grid.Column="0"
                         TextWrapping="Wrap"
                         KeyDown="TextBox_KeyDown"
                         VerticalAlignment="Center"
                         Padding="10"
                         Background="White"
                         Foreground="Black"
                         BorderBrush="Black"
                         BorderThickness="3"
                         AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="150"/>
                <Button Command="{Binding EnviarMensajeCommand}" 
                        Grid.Column="1"
                        IsEnabled="{Binding PuedeEnviar}" 
                        Width="150" 
                        Height="60" 
                        Margin="10,0,0,0" 
                        VerticalAlignment="Center" 
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Image Source="pack://application:,,,/Resource/Images/kunai12.jpg" 
                           Stretch="Uniform"/>
                </Button>
                <Button Content="{Binding Grabando, Converter={StaticResource BoolToMicIconConverter}}"
                        Grid.Column="2"
                        Command="{Binding MicrofonoCommand}"
                        Width="120"
                        Height="50"
                        Background="White"
                        Foreground="Black"
                        BorderBrush="Black"
                        BorderThickness="3"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="17"/>
            </Grid>
        </Border>
    </Grid>
</Window>